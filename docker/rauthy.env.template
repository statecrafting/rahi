# rauthy's environment (spec 031 B-2), rendered once by `rahi first-boot`
# into /data/rauthy/rauthy.env and handed to the rauthy child by
# `rahi supervise`. Every value below is either derived from RAHI_PUBLIC_URL
# or minted into /data/keys; rauthy reads them over an empty config file,
# and an environment value always wins over the file. Do not edit by hand:
# a restart regenerates nothing, and a changed public URL is a new first
# boot on an empty volume.

# The public origin rauthy publishes as its issuer: host and port only,
# rauthy derives the scheme from the proxy or cookie mode below.
PUB_URL=${PUB_URL}

# rauthy listens on loopback only; the app's proxy is its one door
# (constitution VI).
LISTEN_SCHEME=http
LISTEN_ADDRESS=${LISTEN_ADDRESS}
LISTEN_PORT_HTTP=${LISTEN_PORT}

# https: rauthy sits behind the app's proxy and trusts the forwarded scheme
# and host from loopback. http: a local trial, where a host cookie would be
# refused by the browser and the relaxed mode is said out loud (021 B-6).
${SCHEME_MODE}

# WebAuthn's relying party is the public origin; rauthy insists on an
# explicit port in the origin.
RP_ID=${RP_ID}
RP_ORIGIN=${RP_ORIGIN}
RP_NAME=${RP_NAME}

# rauthy's hiqlite: its own Raft cluster, its own directory, ports distinct
# from the app's (constitution VIII). At N=1 this is one node on loopback;
# at N=3 (spec 032) the node id follows the pod ordinal, the peers are the
# pods' stable names, and the listeners open to the pod network.
HQL_NODE_ID=${HQL_NODE_ID}
HQL_NODES=${HQL_NODES}
HQL_LISTEN_ADDR_API=${HQL_LISTEN_ADDR}
HQL_LISTEN_ADDR_RAFT=${HQL_LISTEN_ADDR}
HQL_DATA_DIR=${HQL_DATA_DIR}
HQL_SECRET_RAFT=${HQL_SECRET_RAFT}
HQL_SECRET_API=${HQL_SECRET_API}

# At-rest encryption: one key, minted at first boot, custodied under
# /data/keys/rauthy.json so a backup carries what decrypts the store.
ENC_KEYS=${ENC_KEYS}
ENC_KEY_ACTIVE=${ENC_KEY_ACTIVE}

# The bootstrap admin and the API key the app presents on every admin call
# (spec 021 B-5). The password is printed by first-boot exactly once.
BOOTSTRAP_ADMIN_EMAIL=${ADMIN_EMAIL}
BOOTSTRAP_ADMIN_PASSWORD_PLAIN=${ADMIN_PASSWORD}
BOOTSTRAP_API_KEY=${BOOTSTRAP_API_KEY}
BOOTSTRAP_API_KEY_SECRET=${BOOTSTRAP_API_KEY_SECRET}
